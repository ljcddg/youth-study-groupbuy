/* app.wxss — 全局样式库：清爽绿白风
   页面里尽量复用这里的类，各页面自己的 wxss 只写差异部分 */

page {
  --main: #3BA971;          /* 主色 */
  --main-deep: #2E8B63;
  --price: #E8442E;         /* 价格红 */
  --bg: #F6F8F5;
  --card: #FFFFFF;
  --text: #2E3530;
  --text-sub: #8A928C;
  --line: #EEF2EE;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ============ 布局 ============ */
.page { padding-bottom: 40rpx; }
.page-with-footer { padding-bottom: 180rpx; }
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card-tight { padding: 0; overflow: hidden; }
.first-card { margin-top: 24rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-top { display: flex; align-items: flex-start; justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }

/* ============ 文字 ============ */
.card-title { font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.t-sub { font-size: 24rpx; color: var(--text-sub); line-height: 1.6; }
.t-hint { font-size: 22rpx; color: #B4BAB6; line-height: 1.6; }
.t-strong { font-weight: 600; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ============ 价格 ============ */
.price { color: var(--price); font-weight: 700; }
.price-symbol { font-size: 26rpx; }
.price-num { font-size: 48rpx; }
.money { color: var(--price); font-weight: 600; }

/* ============ 按钮 ============ */
.btn-main {
  background: linear-gradient(90deg, var(--main), var(--main-deep));
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 22rpx 0;
  border: none;
  line-height: 1.5;
}
.btn-main::after { border: none; }
.btn-main[disabled] { opacity: 0.45; color: #fff; }

.btn-ghost {
  background: #fff;
  color: var(--main);
  border: 2rpx solid var(--main);
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 18rpx 0;
  line-height: 1.5;
}
.btn-ghost::after { border: none; }
.btn-ghost[disabled] { opacity: 0.45; }

.btn-gray {
  background: #F2F4F2;
  color: #7A827C;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 18rpx 0;
  line-height: 1.5;
}
.btn-gray::after { border: none; }

.btn-danger {
  background: #FDEDEC;
  color: #D8402C;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 18rpx 0;
  line-height: 1.5;
}
.btn-danger::after { border: none; }

.btn-sm { font-size: 24rpx; padding: 10rpx 28rpx; border-radius: 40rpx; }
.btn-row { display: flex; gap: 20rpx; }
.btn-row > button { flex: 1; }

/* ============ 标签 / 状态 ============ */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tag-green { background: #E4F4EC; color: var(--main-deep); }
.tag-gray { background: #F0EFEB; color: #93998F; }
.tag-blue { background: #E9F1FB; color: #2C6FB5; }
.tag-red { background: #FDEDEC; color: #D8402C; }
.tag-orange { background: #FDF3E3; color: #B2762A; }

.st {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
}
.st-ongoing { background: #E4F4EC; color: #2E8B63; }
.st-closed { background: #F0EFEB; color: #93998F; }
.st-unpaid { background: #F0EFEB; color: #93998F; }
.st-pending { background: #FDF3E3; color: #B2762A; }
.st-confirmed { background: #E4F4EC; color: #2E8B63; }
.st-rejected { background: #FDEDEC; color: #D8402C; }
.st-cancelled { background: #F5F5F5; color: #B4BAB6; }
.st-gray { background: #F0EFEB; color: #93998F; }

/* ============ 表单 ============ */
.form-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.form-item:last-child { border-bottom: none; }
.form-label { width: 190rpx; font-size: 28rpx; color: var(--text); flex-shrink: 0; }
.form-label-req::before { content: '*'; color: var(--price); margin-right: 6rpx; }
.form-input { flex: 1; font-size: 28rpx; text-align: right; }
.form-input-left { flex: 1; font-size: 28rpx; }
.form-ph { color: #C4CAC6; }
.form-col { display: block; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.form-col:last-child { border-bottom: none; }
.form-textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 16rpx;
  background: #F7F9F7;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-tip { font-size: 22rpx; color: var(--text-sub); line-height: 1.7; padding: 16rpx 0 0; }
.picker-value { flex: 1; font-size: 28rpx; text-align: right; color: var(--text); }

/* ============ 列表 ============ */
.list { background: var(--card); border-radius: 24rpx; margin: 0 24rpx 24rpx; overflow: hidden; }
.list-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--card);
}
.list-item:last-child { border-bottom: none; }
.list-item-hover { background: #FAFBFA; }
.li-title { font-size: 30rpx; font-weight: 600; }
.li-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 10rpx; line-height: 1.6; }
.li-right { text-align: right; margin-left: 20rpx; flex-shrink: 0; }

/* ============ 统计块 ============ */
.stat-grid { display: flex; flex-wrap: wrap; }
.stat {
  width: 33.33%;
  box-sizing: border-box;
  text-align: center;
  padding: 16rpx 6rpx;
}
.stat-half { width: 50%; }
.stat-num { font-size: 38rpx; font-weight: 700; color: var(--main-deep); }
.stat-num-red { color: var(--price); }
.stat-label { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; }

/* ============ 空状态 ============ */
.empty { text-align: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 80rpx; opacity: 0.35; }
.empty-text { font-size: 26rpx; color: #B4BAB6; margin-top: 20rpx; line-height: 1.7; }

/* ============ 提示条 ============ */
.note-box {
  background: #F0F8F3;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: var(--main-deep);
  line-height: 1.7;
}
.warn-box {
  background: #FDF3E3;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: #B2762A;
  line-height: 1.7;
}
.danger-box {
  background: #FDEDEC;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: #D8402C;
  line-height: 1.7;
}

/* ============ 底部固定栏 ============ */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #fff;
  padding: 18rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.bar-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #6C736E;
  line-height: 1.4;
  height: 92rpx;
}
.bar-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ============ 弹窗 ============ */
.mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pop {
  background: #fff;
  border-radius: 24rpx;
  width: 620rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx 36rpx 32rpx;
}
.pop-wide { width: 660rpx; }
.pop-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.pop-ft { display: flex; gap: 20rpx; margin-top: 32rpx; }
.pop-ft > button { flex: 1; }

/* ============ 图片 ============ */
.qr-img { width: 420rpx; height: 420rpx; border-radius: 16rpx; background: #F5F5F5; }
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.upload-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #CBD5CC;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #A8B0AA;
  font-size: 24rpx;
  background: #FAFBFA;
}
.upload-icon { font-size: 52rpx; margin-bottom: 8rpx; }

.mono { font-family: "SFMono-Regular", Consolas, monospace; font-size: 24rpx; }

.plan-list { margin-top: 8rpx; }
.plan-item { border: 2rpx solid #E8E5DD; border-radius: 16rpx; padding: 20rpx 24rpx; margin-top: 16rpx; }
.plan-item.on { border-color: var(--main); background: #F2FAF6; }