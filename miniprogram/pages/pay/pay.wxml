<!-- 付款页：微信支付，成功自动确认 -->
<view class="page page-with-footer">

  <view class="empty" wx:if="{{notFound}}">
    <view class="empty-icon">🔍</view>
    <view class="empty-text">未找到该参与记录\n请从「我的参与」重新进入</view>
  </view>

  <block wx:if="{{member}}">

    <view class="card first-card">
      <view class="row-between">
        <view class="flex1">
          <view class="li-title">{{group.name}}</view>
          <view class="t-sub mt8">团长 {{group.leaderName}} · {{member.planName}} 应付 ¥{{member.amountText}}</view>
        </view>
        <view class="st {{statusClass}}">{{statusLabel}}</view>
      </view>
      <view class="warn-box mt24" wx:if="{{member.payStatus === 'pending'}}">付款已提交，正在确认中，请稍候。</view>
      <view class="danger-box mt24" wx:if="{{member.payStatus === 'rejected'}}">付款有异常：{{member.rejectReason || '请重新支付'}}。请重新发起支付。</view>
    </view>

  </block>

  <view class="footer-bar safe-bottom" wx:if="{{member}}">
    <view class="btn-row">
      <button class="btn-ghost" bindtap="goGroup">查看拼团</button>
      <button class="btn-main" wx:if="{{member.payStatus !== 'confirmed'}}" bindtap="wxPay" disabled="{{paying}}">
        {{paying ? '支付中…' : '微信支付'}}
      </button>
      <button class="btn-gray" wx:else disabled>付款已确认</button>
    </view>
  </view>
</view>
