/* 管理端 · 申请审核 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--line);
}
.tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 26rpx; color: var(--text-sub); position: relative; }
.tab-on { color: var(--main-deep); font-weight: 600; }
.tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background: var(--main);
  border-radius: 4rpx;
}
.tab-num { font-size: 20rpx; margin-left: 4rpx; }

.search-row { display: flex; align-items: center; padding: 20rpx 24rpx 4rpx; }
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}
.search-btn { font-size: 26rpx; color: var(--main-deep); margin-left: 20rpx; }
.search-clear { font-size: 24rpx; color: var(--text-sub); margin-left: 16rpx; }

.mode-row { display: flex; gap: 20rpx; }
.mode {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #F2F4F2;
  color: #7A827C;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.mode-on { background: #E4F4EC; color: var(--main-deep); border-color: var(--main); font-weight: 600; }
.mode-off-on { background: #FDEDEC; color: #D8402C; border-color: #E5806F; font-weight: 600; }
