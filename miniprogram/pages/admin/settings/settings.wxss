/* 管理端 · 设置 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  border-bottom: 1rpx solid var(--line);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 28rpx; color: var(--text-sub); position: relative; }
.tab-on { color: var(--main-deep); font-weight: 600; }
.tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background: var(--main);
  border-radius: 4rpx;
}

.cur-qr { width: 320rpx; height: 320rpx; border-radius: 16rpx; background: #F5F5F5; display: block; }
.h-row { padding: 24rpx 0; border-top: 1rpx solid var(--line); }
.h-row:first-of-type { border-top: none; }
.h-qr { width: 110rpx; height: 110rpx; border-radius: 10rpx; background: #F5F5F5; margin-left: 20rpx; flex-shrink: 0; }

.openid-box {
  background: #F7F9F7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 22rpx;
  font-family: "SFMono-Regular", Consolas, monospace;
  color: #4A524C;
  word-break: break-all;
  line-height: 1.6;
}

.a-row { padding: 24rpx 0; border-top: 1rpx solid var(--line); }
.a-row:first-of-type { border-top: none; }
.u-row { display: flex; align-items: center; padding: 22rpx 0; border-top: 1rpx solid var(--line); }
.u-row:first-of-type { border-top: none; }
.arrow-r { font-size: 36rpx; color: #C4CAC6; }
