.page { padding: 24rpx 0 200rpx; }

.order-head { display: flex; justify-content: space-between; align-items: flex-start; }
.order-title { font-size: 36rpx; font-weight: 700; }
.order-tag { margin-top: 16rpx; }

.form-title { font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; }
.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F5F3EE;
  padding: 28rpx 0;
}
.form-label { width: 140rpx; font-size: 28rpx; color: #666; }
.form-input { flex: 1; font-size: 28rpx; }
.form-tip { font-size: 22rpx; color: #BBB; margin-top: 16rpx; }

.rule-card .rule-item { font-size: 24rpx; color: #777; line-height: 1.9; }

/* 底部支付栏 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05);
}
.footer-price { flex: 1; font-size: 26rpx; }
.pay-btn { width: 320rpx; padding: 18rpx 0; }
