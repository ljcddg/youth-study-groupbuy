<!-- 推广中心 -->
<view class="page">
  <!-- 收益概览 -->
  <view class="hero">
    <view class="hero-label">累计推广收益（元）</view>
    <view class="hero-num">{{totalCommission}}</view>
    <view class="hero-sub">
      <text>推广 {{totalCount}} 人</text>
      <text class="split">|</text>
      <text>成交 {{paidCount}} 单</text>
    </view>
  </view>

  <!-- 怎么赚佣金 -->
  <view class="card">
    <view class="card-title">推广怎么赚（简单明了）</view>
    <view class="rate-row">
      <view class="rate-card">
        <view class="rate-price">¥698 年卡</view>
        <view class="rate-get">佣金 ¥{{commissionAnnual || 100}}/单</view>
      </view>
      <view class="rate-card">
        <view class="rate-price">¥99 体验单</view>
        <view class="rate-get">佣金 ¥{{commissionTrial || 10}}/单</view>
      </view>
    </view>
    <view class="step-item"><text class="step-num">1</text><view><view class="step-name">转发分享</view><view class="step-desc">点击下方「转发给家长」，把小程序分享到群或好友</view></view></view>
    <view class="step-item"><text class="step-num">2</text><view><view class="step-name">自动绑定</view><view class="step-desc">家长通过你的分享进入小程序，自动成为你的团成员</view></view></view>
    <view class="step-item"><text class="step-num">3</text><view><view class="step-name">成交拿佣金</view><view class="step-desc">家长成交即得佣金：年卡 ¥{{commissionAnnual || 100}}/单，体验单 ¥{{commissionTrial || 10}}/单</view></view></view>
    <view class="step-note">· 佣金结算规则以后台为准，也可在「团长大厅」管理你的团</view>
    <button class="btn-main share-btn" open-type="share">转发给家长 · 开始推广</button>
  </view>

  <!-- 推广记录 -->
  <view class="card">
    <view class="card-title">我的推广记录</view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{records.length === 0}}" class="empty">
      还没有推广记录，转发给家长就开始啦
    </view>
    <view wx:else>
      <view class="record" wx:for="{{records}}" wx:key="index">
        <view class="record-left">
          <view class="record-name">{{item.objectName}}</view>
          <view class="record-time">{{item.time}}</view>
        </view>
        <view class="record-right">
          <view class="record-type">{{item.typeLabel}}</view>
          <view class="record-status {{item.paid ? 'paid' : 'waiting'}}">{{item.statusLabel}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
