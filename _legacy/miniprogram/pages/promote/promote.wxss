.page { padding-bottom: 60rpx; }

/* 佣金两档展示 */
.rate-row { display: flex; gap: 20rpx; margin-bottom: 30rpx; }
.rate-card {
  flex: 1;
  background: #F0F8F3;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.rate-price { font-size: 26rpx; color: var(--text); font-weight: 600; }
.rate-get { font-size: 32rpx; color: var(--main-deep); font-weight: 700; margin-top: 10rpx; }

.hero {
  background: linear-gradient(135deg, #4CAF7D, #2E8B63);
  color: #fff;
  text-align: center;
  padding: 56rpx 40rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.hero-label { font-size: 26rpx; opacity: .9; }
.hero-num { font-size: 88rpx; font-weight: 700; line-height: 1.3; }
.hero-sub { font-size: 26rpx; opacity: .95; margin-top: 8rpx; }
.split { margin: 0 20rpx; opacity: .6; }

.step-item { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.step-item:last-of-type { margin-bottom: 16rpx; }
.step-num {
  width: 44rpx; height: 44rpx;
  background: var(--main);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.step-name { font-size: 30rpx; font-weight: 600; }
.step-desc { font-size: 24rpx; color: var(--text-sub); margin-top: 6rpx; line-height: 1.6; }
.step-note { font-size: 22rpx; color: #BBB; margin-bottom: 24rpx; }
.share-btn { margin-top: 8rpx; }

.empty { text-align: center; color: #BBB; font-size: 26rpx; padding: 40rpx 0; }

.record {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F3EE;
}
.record:last-child { border-bottom: none; }
.record-name { font-size: 28rpx; font-weight: 600; }
.record-time { font-size: 22rpx; color: #BBB; margin-top: 6rpx; }
.record-right { text-align: right; }
.record-type { font-size: 24rpx; color: #666; }
.record-status { font-size: 26rpx; font-weight: 600; margin-top: 6rpx; }
.record-status.paid { color: var(--accent); }
.record-status.waiting { color: #999; }
