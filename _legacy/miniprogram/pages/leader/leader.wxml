<!-- 团长大厅 -->
<view class="page">

  <!-- 顶部三栏切换 -->
  <view class="tabs">
    <view class="tab {{mode === 'browse' ? 'active' : ''}}" bindtap="switchMode" data-mode="browse">找团加入</view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">成为团长</view>
    <view class="tab {{mode === 'myteam' ? 'active' : ''}}" bindtap="switchMode" data-mode="myteam">我的团</view>
  </view>

  <!-- 找团加入 -->
  <block wx:if="{{mode === 'browse'}}">
    <view class="card intro">
      <view class="intro-title">输入团长手机号或姓名，找到 TA 的团</view>
      <view class="intro-sub">也可以直接点家长分享的卡片，自动进对应团</view>
    </view>
    <view class="card search-card">
      <view class="search-row">
        <input class="search-input" placeholder="输入团长手机号 / 姓名" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search" />
        <button class="btn-main search-btn" disabled="{{searching}}" bindtap="search">{{searching ? '搜索中' : '搜索'}}</button>
      </view>
      <view class="search-tip" wx:if="{{joinedLeader}}">你已加入「{{joinedLeader.name}}」的团 · {{joinedLeader.time}}</view>
    </view>

    <view class="card" wx:if="{{searched && results.length === 0}}">
      <view class="empty">没找到对应的团，确认手机号/姓名后再试试</view>
    </view>

    <view class="card leader-item" wx:for="{{results}}" wx:key="leaderId">
      <view class="leader-info">
        <view class="leader-name">{{item.name}} 的团</view>
        <view class="leader-phone">手机号 {{item.phone}} · {{item.memberCount}} 位成员</view>
      </view>
      <button class="btn-main join-btn" wx:if="{{!item.isMine && !joinedLeader}}" bindtap="join" data-id="{{item.leaderId}}" data-name="{{item.name}}">加入</button>
      <view class="tag tag-green" wx:if="{{item.isMine}}">我的团</view>
    </view>
  </block>

  <!-- 成为团长 -->
  <block wx:if="{{mode === 'register'}}">
    <view class="card intro">
      <view class="intro-title">成为团长，分享赚佣金</view>
      <view class="intro-sub">年卡成交佣金 ¥100 / 单，体验单成交佣金 ¥10 / 单</view>
      <view class="intro-sub">一个团人数不限 · 家长点你分享的卡片自动进你的团</view>
    </view>
    <view class="card">
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入真实姓名" value="{{regName}}" bindinput="onRegName" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="家长将通过手机号找到你" value="{{regPhone}}" bindinput="onRegPhone" />
      </view>
      <button class="btn-main reg-btn" disabled="{{submitting}}" bindtap="register">{{submitting ? '提交中…' : '注册成为团长'}}</button>
      <view class="form-tip">注册后，把小程序分享给家长即可；家长下单后佣金自动记录到你的推广收益里</view>
    </view>
  </block>

  <!-- 我的团 -->
  <block wx:if="{{mode === 'myteam'}}">
    <view class="card" wx:if="{{myTeam}}">
      <view class="myteam-head">
        <view>
          <view class="intro-title">{{myTeam.name}} 的团</view>
          <view class="intro-sub">手机号 {{myTeam.phone}} · 团成员 {{myTeam.memberCount}} 位（人数不限）</view>
        </view>
        <button class="btn-main share-mini" open-type="share">分享拉新</button>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="empty">你还不是团长，先去「成为团长」注册吧</view>
      <button class="btn-ghost" bindtap="switchMode" data-mode="register">去注册</button>
    </view>
    <view class="card" wx:if="{{myTeam && myTeam.members.length > 0}}">
      <view class="card-title">团成员</view>
      <view class="member-item" wx:for="{{myTeam.members}}" wx:key="time">
        <view>
          <view class="member-name">{{item.objectName}}</view>
          <view class="member-time">{{item.time}}</view>
        </view>
        <view class="tag {{item.statusLabel === '已成交' ? 'tag-green' : 'tag-gray'}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="card" wx:if="{{myTeam && myTeam.members.length === 0}}">
      <view class="empty">还没有成员，快分享给家长吧</view>
    </view>
  </block>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</view>
